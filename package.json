{
	"name": "cdk-bun-1",
	"version": "0.1.0",
	"scripts": {
		"test": "bun test test/*.test.ts",
		"list": "cdk list",
		"synth": "cdk synth",
		"deploy": "cdk deploy --express --outputs-file outputs.json",
		"bootstrap": "cdk bootstrap --express",
		"diff": "cdk diff",
		"destroy": "cdk destroy --express",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix",
		"curl": "curl \"$(jq .CdkBun1Stack.fnUrl outputs.json -r)\""
	},
	"dependencies": {
		"aws-cdk-lib": "^2.274.0",
		"constructs": "^10.8.1"
	},
	"devDependencies": {
		"@types/aws-lambda": "^8.10.164",
		"aws-cdk": "2.1146.1",
		"bun-types": "^1.4.4",
		"cdk-nag": "^3.0.2",
		"esbuild": "^0.28.2"
	}
}
